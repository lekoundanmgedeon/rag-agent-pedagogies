# ============================================================================
# Agent Tuteur Sénégal — variables d'environnement (exemple)
# Copier vers .env et ajuster. Toutes ont un défaut sûr pour la démo hors-ligne.
# ============================================================================

# --- Persistance relationnelle (étape 4) ---
# IMPORTANT (RLS) : en production, DATABASE_URL doit utiliser un rôle NON-superuser
# (CREATE ROLE ... NOSUPERUSER). Un superuser Postgres contourne TOUJOURS le Row
# Level Security (migration 0002_enable_rls), même avec FORCE ROW LEVEL SECURITY.
# Le POSTGRES_USER par défaut d'une image postgres officielle EST superuser :
# ne pas l'utiliser tel quel en production multi-tenant.
DATABASE_URL=postgresql+asyncpg://tuteur:tuteur@localhost:5432/tuteur

# --- Queue asynchrone (étape 6+) ---
REDIS_URL=redis://localhost:6379/0

# --- Vecteurs ---
# VECTOR_BACKEND: memory (défaut, sans serveur) | qdrant
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=curriculum

# --- Embeddings ---
# EMBEDDING_BACKEND: light (défaut, déterministe hors-ligne) | bge_m3
EMBEDDING_BACKEND=bge_m3
EMBEDDING_DENSE_DIM=256

# --- LLM (chaîne de repli : le dernier maillon est toujours le mock) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# LLM_BACKEND: auto (défaut, compose selon les clés disponibles)
#              | mistral | gemini | ollama | mock
LLM_BACKEND=auto
# LLM_CHAIN impose l'ordre exact et l'emporte sur LLM_BACKEND. C'est le moyen de
# changer de fournisseur principal sans toucher au code ni redéployer.
# Exemple : LLM_CHAIN=gemini,mistral,mock
LLM_CHAIN=

# --- API (étape 5+) ---
API_BASE_URL=http://localhost:8000
MAX_FILE_SIZE_MB=25
DEFAULT_TENANT=default
JWT_SECRET=change-me-in-production

# --- Recherche / RAG ---
RETRIEVAL_TOP_K=5
RRF_K=60
# RAG_SEUIL_PERTINENCE : cosinus dense minimal sous lequel AUCUN extrait n'est
# servi (cas QA #5). Laisser vide = seuil de l'embedder, qui seul connaît son
# espace vectoriel — c'est le cas normal. À ne renseigner que pour réajuster la
# valeur sur l'index réel, sans redéployer. Sans effet sous EMBEDDING_BACKEND=light,
# où aucun seuil n'est posable (les deux nuages de scores s'y recouvrent).
RAG_SEUIL_PERTINENCE=
# RAG_CONSENSUS_CHAPITRE : fraction du top-k devant se porter sur un MÊME
# chapitre pour que la question soit jugée dans le périmètre du corpus (cas QA
# #5). C'est la vraie règle de périmètre : mesuré sur les 12 leçons, aucun score
# scalaire ne sépare les questions couvertes des questions étrangères, alors que
# ce consensus donne 5,7 % de faux rejets pour 16,7 % de faux services à 0,8.
# Laisser vide = valeur de l'embedder (0,8 sous bge_m3 ; aucune sous light, où
# la règle donnerait 40 % de faux rejets).
#
# ATTENTION — la règle suppose un index COMPLET. Son pouvoir discriminant vient
# de la largeur du corpus : mesuré sur un index réduit à 2 chapitres, elle laisse
# passer 66,7 % des questions étrangères, faute d'ailleurs où les résultats
# puissent se disperser.
RAG_CONSENSUS_CHAPITRE=
