# Image mono-conteneur : le SPA Vue et l'API FastAPI dans le même service.
#
# Pourquoi séparée de agent-tuteur-api/Dockerfile et agent-tuteur-web/Dockerfile,
# qui restent la référence pour Docker Compose : les PaaS type Render ne lisent
# pas docker-compose.yml et facturent au service. Regrouper SPA + API dans un
# seul conteneur donne une démo à un seul service (donc un seul démarrage à
# froid sur les offres gratuites), sans CORS ni proxy intermédiaire susceptible
# de bufferiser le flux SSE de /api/chat.
#
# Le contexte de build est la RACINE du dépôt (les deux sous-projets sont
# nécessaires) :
#   docker build -f Dockerfile.render -t agent-tuteur-demo .

# --- Étape 1 : build du SPA Vue ---
FROM node:20-alpine AS web
WORKDIR /web
COPY agent-tuteur-web/package.json agent-tuteur-web/package-lock.json ./
RUN npm ci
COPY agent-tuteur-web/ ./
RUN npm run build

# --- Étape 2 : runtime Python (identique à agent-tuteur-api/Dockerfile) ---
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY agent-tuteur-api/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY agent-tuteur-api/pyproject.toml ./
COPY agent-tuteur-api/src ./src
COPY agent-tuteur-api/migrations ./migrations
COPY agent-tuteur-api/alembic.ini ./
COPY agent-tuteur-api/corpus ./corpus
COPY agent-tuteur-api/scripts ./scripts

RUN pip install --no-cache-dir -e .

# Build statique du SPA, servi par FastAPI (cf. api/main.py::_mount_spa).
COPY --from=web /web/dist ./web
ENV SPA_DIST_DIR=/app/web

COPY agent-tuteur-deploy/render-start.sh ./render-start.sh
RUN chmod +x ./render-start.sh

ENV PYTHONPATH=/app/src \
    PORT=8000

EXPOSE 8000

CMD ["./render-start.sh"]
